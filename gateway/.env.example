TOLLGATE_APP_NAME=Tollgate
# Use separate control and warden processes for the cluster deployment.
TOLLGATE_SERVICE_ROLE=standalone
TOLLGATE_NODE_ID=local
# This policy applies only to control-service outages. Ledger failures always block.
TOLLGATE_CONTROL_FAILURE_POLICY=fail_open
TOLLGATE_HEARTBEAT_SECONDS=5
TOLLGATE_NODE_STALE_SECONDS=20
TOLLGATE_EXPECTED_WARDENS=["warden-1","warden-2"]
TOLLGATE_ENVIRONMENT=development
TOLLGATE_MODE=simulator
TOLLGATE_PUBLIC_ORIGIN=http://127.0.0.1:8000
TOLLGATE_DOCS_ENABLED=true
# Generated by manage.py setup. This is the owner key, not a customer key.
TOLLGATE_DEVELOPMENT_API_KEY=
TOLLGATE_PROVIDER_API_KEY=
TOLLGATE_DATABASE_PATH=data/tollgate.db
# PostgreSQL: set this environment variable only when using PostgreSQL.
# TOLLGATE_DATABASE_URL=postgresql://tollgate:password@127.0.0.1:5432/tollgate
TOLLGATE_PROVIDER_BASE_URL=http://127.0.0.1:8001
TOLLGATE_OPENAI_API_KEY=
TOLLGATE_ANTHROPIC_API_KEY=
TOLLGATE_GEMINI_API_KEY=
TOLLGATE_ENABLED_PROVIDERS=["openai","anthropic","gemini"]
# Enables retrieval of stored OpenAI responses for recovery; review provider retention first.
TOLLGATE_OPENAI_STORE_RESPONSES=false
TOLLGATE_MODEL_CATALOG_PATH=models.json
TOLLGATE_PRICE_MAX_AGE_DAYS=30
TOLLGATE_SESSION_HOURS=8
TOLLGATE_CUSTOMER_REQUESTS_PER_MINUTE=60
TOLLGATE_CUSTOMER_CONCURRENCY=5
TOLLGATE_ADMIN_REQUESTS_PER_MINUTE=300
TOLLGATE_MAX_REQUEST_BYTES=262144
TOLLGATE_BODY_READ_TIMEOUT_SECONDS=10
TOLLGATE_PROVIDER_TIMEOUT_SECONDS=180
TOLLGATE_MAX_PROVIDER_BYTES=4194304
TOLLGATE_WORKER_ENABLED=true
TOLLGATE_WORKER_INTERVAL_SECONDS=1
TOLLGATE_RECOVERY_AFTER_SECONDS=240
TOLLGATE_SIMULATOR_SCENARIO=normal
TOLLGATE_SIMULATOR_DELAY_SECONDS=0.1
TOLLGATE_STRIPE_SECRET_KEY=
TOLLGATE_STRIPE_WEBHOOK_SECRET=
TOLLGATE_STRIPE_LIVE_MODE=false

# --- Offline continuity (v1.2) ---
# Create with: python manage.py offline-secret. The relay host needs the SAME value.
TOLLGATE_ALLOWANCE_SECRET=
TOLLGATE_ALLOWANCE_MAX_MICRO=5000000
TOLLGATE_ALLOWANCE_MAX_TTL_MINUTES=1440
TOLLGATE_ALLOWANCE_MAX_ACTIVE=3
TOLLGATE_ALLOWANCE_SYNC_GRACE_SECONDS=86400
# Public address of the standby relay, returned to customer apps with each allowance.
TOLLGATE_RELAY_URL=
# Alerts (watchdog host only). Email via SMTP; SMS via any HTTPS webhook accepting {"to","message"}.
TOLLGATE_SMTP_HOST=
TOLLGATE_SMTP_PORT=587
TOLLGATE_SMTP_USERNAME=
TOLLGATE_SMTP_PASSWORD=
TOLLGATE_SMTP_FROM=
TOLLGATE_SMS_WEBHOOK_URL=
TOLLGATE_SMS_WEBHOOK_TOKEN=
TOLLGATE_WATCH_READY_URL=
TOLLGATE_WATCH_CONTROL_URL=
TOLLGATE_WATCH_INTERVAL_SECONDS=10
TOLLGATE_WATCH_FAILURES_TO_ALERT=3

# --- Direct emergency access (last resort; OFF by default) ---
# These keys LEAVE the gateway and are handed to approved customers' apps. Create separate
# RESTRICTED provider keys with a spending limit set at the provider, never your main keys.
TOLLGATE_EMERGENCY_DIRECT_ENABLED=false
# JSON list of customer IDs allowed to receive emergency keys, e.g. ["cus_abc123"]
TOLLGATE_DIRECT_CUSTOMERS=[]
TOLLGATE_EMERGENCY_OPENAI_KEY=
TOLLGATE_EMERGENCY_ANTHROPIC_KEY=
TOLLGATE_EMERGENCY_GEMINI_KEY=
